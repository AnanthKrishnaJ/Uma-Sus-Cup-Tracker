<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SUS CUP - Discord Race Tracker</title>
    <!-- Fonts and Icons -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --bg-color: #f1f1ef;
            --card-bg: #ffffff;
            --text-main: #101010;
            --text-muted: #6f6f6b;
            --primary: #111111;
            --primary-hover: #3a3a38;
            --accent-dark: #111111;
            --accent-light: #e8e8e5;
            --gold: #b7b7af;
            --silver: #d9d9d5;
            --bronze: #8d8d86;
            --rank-s: #111111;
            --rank-a: #4b4b48;
            --rank-b: #888883;
            --rank-c: #c9c9c4;
            --radius-lg: 6px;
            --radius-md: 4px;
            --radius-sm: 3px;
            --shadow: 0 14px 40px rgba(0, 0, 0, 0.06);
            --shadow-hover: 0 18px 45px rgba(0, 0, 0, 0.12);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Manrope', sans-serif;
            background: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
        }

        h1, h2, h3, h4 { font-weight: 800; letter-spacing: 0; }
        h2, h3 { font-family: 'Playfair Display', serif; }

        /* --- SIDEBAR --- */
        .sidebar {
            width: 280px;
            background: #111111;
            position: fixed;
            height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 30px 20px;
            border-right: 1px solid #292929;
            z-index: 100;
        }

        .logo-area { margin-bottom: 40px; padding: 0 10px; }
        .logo-area h1 { font-size: 2.2rem; color: #fff; line-height: 1.1; }
        .logo-area p { font-size: 0.68rem; color: #999; font-weight: 700; margin-top: 10px; letter-spacing: 2px; }

        .nav-links { list-style: none; flex: 1; }
        .nav-links a {
            display: flex; align-items: center; gap: 15px;
            padding: 16px 20px; text-decoration: none;
            color: #999; font-weight: 700; font-size: 0.82rem;
            border-radius: 3px; margin-bottom: 8px; transition: all 0.2s; letter-spacing: .4px;
        }
        .nav-links a:hover { background: #292929; color: #fff; }
        .nav-links a.active { background: var(--accent-dark); color: white; }
        
        .nav-links a.btn-add {
            background: #fff; color: #111; justify-content: center; 
            margin-top: 20px; box-shadow: none;
        }
        .nav-links a.btn-add:hover { background: #d4d4d0; color: #111; transform: translateY(-2px); }

        .sidebar-bottom { display: flex; justify-content: center; gap: 10px; padding-top: 20px; }
        .sidebar-bottom button {
            background: #292929; border: none; width: 40px; height: 40px; border-radius: 3px;
            cursor: pointer; transition: 0.2s; color: #fff; font-size: 0.9rem;
        }
        .sidebar-bottom button:hover { background: #444; }

        /* --- MAIN CONTENT --- */
        .main-content {
            margin-left: 280px;
            padding: 40px 50px;
            flex: 1;
            max-width: 1400px;
        }

        .view-section { display: none; animation: fadeIn 0.4s ease-out; }
        .view-section.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

        .page-header { margin-bottom: 30px; display: flex; justify-content: space-between; align-items: flex-end; }
        .page-header h2 { font-size: 2.5rem; }
        .page-header p { color: var(--text-muted); font-weight: 700; font-size: 1.1rem; }

        /* --- UI COMPONENTS --- */
        .card {
            background: var(--card-bg); border-radius: var(--radius-lg);
            padding: 30px; box-shadow: var(--shadow); margin-bottom: 30px; border: 1px solid #dededb;
        }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }

        /* Pill List Items (Inspired by daily routine UI) */
        .list-item {
            display: flex; align-items: center; padding: 20px 25px;
            background: #ffffff; border-radius: var(--radius-md); margin-bottom: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.02); transition: 0.2s;
            border: 1px solid #dededb; cursor: pointer;
        }
        .list-item:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); border-color: #111; }
        
        .avatar-circle {
            width: 55px; height: 55px; border-radius: 3px; background: var(--accent-light);
            color: var(--primary); display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 1.4rem; margin-right: 20px; overflow: hidden;
            border: 2px solid #fff; box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }
        
        .item-content { flex: 1; }
        .item-title { font-weight: 800; font-size: 1.05rem; color: var(--text-main); margin-bottom: 2px; }
        .item-subtitle { font-weight: 700; font-size: 0.95rem; color: var(--text-muted); }
        
        .item-right { text-align: right; }
        .item-value { font-weight: 900; font-size: 1.5rem; color: var(--text-main); }
        .item-label { font-weight: 700; font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; }

        /* Stats Blocks */
        .stat-block {
            background: var(--card-bg); padding: 25px; border-radius: var(--radius-md);
            box-shadow: var(--shadow); text-align: left; border-bottom: 3px solid var(--accent-dark);
        }
        .stat-block .val { font-size: 2.5rem; font-weight: 900; color: var(--text-main); line-height: 1; }
        .stat-block .lbl { font-size: 0.9rem; font-weight: 800; color: var(--text-muted); margin-top: 8px; text-transform: uppercase; }

        /* Badges */
        .badge { padding: 4px 10px; border-radius: 2px; font-size: 0.68rem; font-weight: 800; color: white; display: inline-block; letter-spacing: 1px; }
        .badge-a { background: var(--rank-a); }
        .badge-b { background: var(--rank-b); }
        .badge-c { background: var(--rank-c); }
        .badge-s { background: var(--rank-s); }
        
        .rank-diff { display: inline-flex; align-items: center; justify-content: center; font-weight: 900; font-size: 1rem; width: 50px; }
        .diff-up { color: #7cb342; }
        .diff-down { color: #e53935; }
        .diff-new { color: var(--primary); font-size: 0.8rem; }
        .diff-none { color: #bcaaa4; }

        /* Forms */
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; font-weight: 800; margin-bottom: 8px; color: var(--text-main); }
        .form-control {
            width: 100%; padding: 15px 20px; border: 1px solid #d4d4d0; border-radius: var(--radius-sm);
            font-family: 'Manrope'; font-weight: 600; font-size: 1rem; color: var(--text-main);
            background: #fafaf8; transition: 0.2s;
        }
        .form-control:focus { border-color: var(--primary); background: #ffffff; outline: none; }
        
        .btn {
            padding: 15px 30px; border-radius: 3px; border: none; font-family: 'Manrope'; 
            font-weight: 900; font-size: 1.1rem; cursor: pointer; transition: 0.2s;
        }
        .btn-primary { background: var(--primary); color: white; box-shadow: none; }
        .btn-primary:hover { background: var(--primary-hover); transform: translateY(-2px); }
        .btn-outline { background: transparent; border: 2px solid var(--accent-dark); color: var(--accent-dark); }
        .btn-outline:hover { background: var(--accent-dark); color: white; }

        /* Race Participant Rows */
        .participant-row {
            display: grid; grid-template-columns: 80px 1fr 1fr 80px 100px; gap: 15px; 
            align-items: end; padding: 20px; background: #fafaf8; border-radius: var(--radius-md); 
            margin-bottom: 15px; border: 1px solid #dededb;
        }

        .dashboard-hero { display: grid; grid-template-columns: 1.15fr .85fr; min-height: 255px; overflow: hidden; padding: 0; background: #111; color: #fff; border: none; }
        .dashboard-hero-copy { padding: 38px 40px; display: flex; flex-direction: column; justify-content: space-between; }
        .eyebrow { font-family: 'DM Mono', monospace; text-transform: uppercase; letter-spacing: 2px; font-size: .68rem; color: #a8a8a2; }
        .dashboard-hero h2 { font-size: clamp(2rem, 4vw, 3.5rem); line-height: .98; max-width: 480px; color: #fff; }
        .dashboard-hero p { color: #b5b5b0; font-size: .9rem; max-width: 380px; }
        .official-art { min-height: 255px; background: #444 url('https://img.youtube.com/vi/dbKYZHvhlJ8/maxresdefault.jpg') center/cover; position: relative; }
        .official-art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, #111 0%, transparent 45%); }
        .source-link { color: #999; font-size: .68rem; text-decoration: none; letter-spacing: .5px; }
        .source-link:hover { color: #fff; }
        .uma-image { width: 55px; height: 55px; object-fit: contain; object-position: center; margin-right: 20px; border: 2px solid #fff; background: #e8e8e5; }
        .uma-image-large { width: min(360px, 100%); height: auto; max-height: none; object-fit: contain; object-position: center; border: 2px solid #111; background: #e8e8e5; margin: 0 auto 15px; display: block; }
        .npc-face { object-fit: cover; object-position: center 22%; border-radius: 50%; }
        .record-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px; }
        .record-count { font-family: 'DM Mono', monospace; font-size: .68rem; color: var(--text-muted); letter-spacing: 1px; }
        .record-winner { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .record-winner > div { border-left: 2px solid var(--text-main); padding-left: 14px; }
        .record-winner strong, .record-winner span { display: block; }
        .record-winner strong { font-size: 1.05rem; }
        .record-winner span { color: var(--text-muted); font-size: .72rem; margin-top: 5px; }
        .race-meta { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 18px; color: #b5b5b0; font-family: 'DM Mono', monospace; font-size: .68rem; }
        .race-gallery { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 30px; }
        .race-gallery a { display: block; overflow: hidden; border: 1px solid #dededb; background: #fff; }
        .race-gallery img { width: 100%; aspect-ratio: 9 / 16; display: block; object-fit: cover; transition: transform .25s ease; }
        .race-gallery a:hover img { transform: scale(1.03); }
        .intro-copy { max-width: 820px; color: var(--text-muted); line-height: 1.8; }
        .intro-copy p { margin-bottom: 16px; }
        .intro-list { columns: 2; margin: 10px 0 18px 20px; color: var(--text-muted); line-height: 1.9; }
        .creator-credit { border-top: 1px solid #dededb; margin-top: 20px; padding-top: 15px; font-family: 'DM Mono', monospace; font-size: .72rem; letter-spacing: 1px; text-transform: uppercase; }
        .timeline { position: relative; margin-left: 12px; padding-left: 28px; border-left: 2px solid #dededb; }
        .timeline-item { position: relative; margin-bottom: 22px; }
        .timeline-item::before { content: ''; position: absolute; left: -36px; top: 18px; width: 12px; height: 12px; border-radius: 50%; background: var(--primary); border: 3px solid var(--bg-color); }
        .info-section h3 { margin-bottom: 12px; }
        .info-section p, .info-section li { color: var(--text-muted); line-height: 1.75; }
        .info-section ul { margin: 0 0 18px 20px; }
        @media (max-width: 768px) { .intro-list { columns: 1; } }

        @media (max-width: 768px) {
            .dashboard-hero { grid-template-columns: 1fr; }
            .official-art { min-height: 150px; }
            .dashboard-hero-copy { min-height: 230px; padding: 28px; }
            .record-winner { grid-template-columns: 1fr; gap: 16px; }
            .race-gallery { grid-template-columns: repeat(2, 1fr); }
        }

        /* Mobile Adjustments */
        @media (max-width: 1024px) {
            .sidebar { width: 100px; padding: 20px 10px; }
            .logo-area h1, .logo-area p, .nav-links span { display: none; }
            .nav-links a { justify-content: center; padding: 15px; }
            .main-content { margin-left: 100px; max-width: calc(100vw - 100px); padding: 30px; }
            .grid-4, .grid-3 { grid-template-columns: 1fr 1fr; }
        }
        @media (max-width: 768px) {
            .sidebar { display: none; }
            .main-content { margin-left: 0; max-width: 100vw; padding: 20px; }
            .grid-4, .grid-3, .grid-2 { grid-template-columns: 1fr; }
            .participant-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <nav class="sidebar">
        <div class="logo-area">
            <h1>SUS<br>CUP</h1>
            <p>RACE TRACKER</p>
        </div>
        <ul class="nav-links">
            <li><a href="#" data-nav="dashboard" class="active"><i class="fa-solid fa-house"></i> <span>Home</span></a></li>
            <li><a href="#" data-nav="history"><i class="fa-solid fa-trophy"></i> <span>Sus Cups</span></a></li>
            <li><a href="#" data-nav="archive"><i class="fa-solid fa-flag-checkered"></i> <span>Race Archive</span></a></li>
            <li><a href="#" data-nav="players"><i class="fa-solid fa-medal"></i> <span>Hall of Fame</span></a></li>
            <li><a href="#" data-nav="umas"><i class="fa-solid fa-horse-head"></i> <span>Umas</span></a></li>
            <li><a href="#" data-nav="info"><i class="fa-solid fa-circle-info"></i> <span>Info</span></a></li>
            <li><a href="#" data-nav="add-race" class="btn-add"><i class="fa-solid fa-plus"></i> <span>New Race</span></a></li>
        </ul>
        <div class="sidebar-bottom">
            <button onclick="App.exportData()" title="Export JSON"><i class="fa-solid fa-download"></i></button>
            <button onclick="document.getElementById('import-file').click()" title="Import JSON"><i class="fa-solid fa-upload"></i></button>
            <button onclick="App.resetData()" title="Reset Database" style="color:var(--primary);"><i class="fa-solid fa-rotate-right"></i></button>
            <input type="file" id="import-file" style="display:none;" accept=".json" onchange="App.importData(event)">
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main class="main-content">
        
        <!-- DASHBOARD VIEW -->
        <div id="view-dashboard" class="view-section active">
            <div class="page-header">
                <div>
                    <h2>Overview</h2>
                    <p>Track your progress and insights</p>
                </div>
            </div>

            <section class="card dashboard-hero">
                <div class="dashboard-hero-copy">
                    <span class="eyebrow">Official Uma Musume archive / 001</span>
                    <h2>Race day, recorded in monochrome.</h2>
                    <div>
                        <p>Your private Sus Cup record for every player, finish, and Uma.</p>
                    </div>
                </div>
                <a class="official-art" href="https://umamusume.com/" target="_blank" rel="noopener" aria-label="Open the official Uma Musume website"></a>
            </section>

            <section class="card">
                <div class="record-heading"><span class="eyebrow">The archive / about the series</span><span class="record-count">CREATED BY ANANTH</span></div>
                <h3 style="font-size:2rem; margin-bottom:15px;">What is Sus Cup?</h3>
                <div class="intro-copy">
                    <p>Sus Cup is a community-organized Uma Musume tournament series created to record and celebrate competitive races between players.</p>
                    <p>The tournament tracker was made as a complete historical archive for every Sus Cup, preserving each race's details, participants, Uma Musume entries, complete results, champions, and all-time records.</p>
                    <p>Each Sus Cup has its own race conditions, track, distance, participants, and final results. The purpose of this website is to ensure that every tournament remains permanently documented and that the achievements of players and their Umas are remembered.</p>
                    <strong>The tracker records:</strong>
                    <ul class="intro-list">
                        <li>Every Sus Cup tournament</li><li>Race dates and room IDs</li><li>Track and race conditions</li><li>All participating players</li><li>All Uma Musume entries</li><li>Complete finishing positions</li><li>NPC/Mob Uma participants</li><li>Character versions and special outfits</li><li>Individual Sus Cup champions</li><li>All-time winning players and Umas</li><li>Full tournament history</li>
                    </ul>
                    <p>This website is not based on a points system. Its purpose is to create a permanent historical record of the Sus Cup tournament series and celebrate every race, competitor, champion, and winning Uma.</p>
                </div>
                <div class="creator-credit">Sus Cup Tournament Tracker &nbsp;|&nbsp; Created and maintained by Ananth</div>
            </section>

            <div class="grid-2" style="margin-bottom:30px;">
                <div class="card" id="latest-cup-summary"></div>
                <div class="card">
                    <span class="eyebrow">Complete tournament archive</span>
                    <h3 style="font-size:1.7rem; margin:15px 0 10px;">Every race, every finish</h3>
                    <p class="intro-copy">Browse the full Sus Cup history, including race conditions, all runner entries, NPC/Mob Umas, champions, and final positions.</p>
                    <button class="btn btn-outline" style="margin-top:18px;" onclick="App.navigate('archive')">Open Race Archive <i class="fa-solid fa-arrow-right"></i></button>
                </div>
            </div>
            
            <div class="grid-4" style="margin-bottom: 40px;" id="dash-stats"></div>
            <div class="card" id="championship-record"></div>

            <div class="grid-2">
                <div>
                    <h3 style="margin-bottom: 20px; display:flex; align-items:center; gap:10px;"><i class="fa-solid fa-trophy" style="color:var(--primary)"></i> Player Rankings</h3>
                    <div id="dash-player-list"></div>
                    <button class="btn btn-outline" style="width:100%; margin-top:10px;" onclick="App.navigate('players')">See All Players</button>
                </div>
                <div>
                    <h3 style="margin-bottom: 20px; display:flex; align-items:center; gap:10px;"><i class="fa-solid fa-star" style="color:var(--gold)"></i> Top Umas</h3>
                    <div id="dash-uma-list"></div>
                    <button class="btn btn-outline" style="width:100%; margin-top:10px;" onclick="App.navigate('umas')">See All Umas</button>
                </div>
            </div>
        </div>

        <!-- SUS CUP HISTORY VIEW -->
        <div id="view-history" class="view-section">
            <div class="page-header"><div><h2>Sus Cup History</h2><p>Every tournament, preserved in chronological order</p></div></div>
            <div class="timeline" id="history-timeline"></div>
        </div>

        <!-- RACE ARCHIVE VIEW -->
        <div id="view-archive" class="view-section">
            <div class="page-header">
                <div>
                    <h2>Race Archive</h2>
                    <p>Complete history of all Sus Cup events</p>
                </div>
            </div>
            <div class="grid-2" id="archive-grid"></div>
        </div>

        <!-- INFO VIEW -->
        <div id="view-info" class="view-section">
            <div class="page-header"><div><h2>About Sus Cup</h2><p>The record behind the races</p></div></div>
            <div id="info-content"></div>
        </div>

        <!-- RACE DETAIL VIEW -->
        <div id="view-race-detail" class="view-section">
            <button class="btn btn-outline" style="margin-bottom:20px; padding: 10px 20px;" onclick="App.navigate('archive')"><i class="fa-solid fa-arrow-left"></i> Back</button>
            <div id="race-detail-content"></div>
        </div>

        <!-- PLAYERS VIEW -->
        <div id="view-players" class="view-section">
            <div class="page-header">
                <h2>Leaderboard</h2>
                <p>Overall player standings</p>
                <input type="text" id="search-players" class="form-control" style="margin-top:15px; width:100%;" placeholder="Search trainers..." oninput="App.renderPlayers()">
            </div>
            <div id="full-player-list"></div>
        </div>

        <!-- UMAS VIEW -->
        <div id="view-umas" class="view-section">
            <div class="page-header">
                <h2>Uma Database</h2>
                <p>Performance statistics by character</p>
                <input type="text" id="search-umas" class="form-control" style="margin-top:15px; width:100%;" placeholder="Search Umas..." oninput="App.renderUmas()">
            </div>
            <div id="full-uma-list"></div>
        </div>
        
        <!-- PROFILE VIEW -->
        <div id="view-profile" class="view-section">
            <button class="btn btn-outline" style="margin-bottom:20px; padding: 10px 20px;" onclick="App.navigate('dashboard')"><i class="fa-solid fa-arrow-left"></i> Back</button>
            <div id="profile-content"></div>
        </div>

        <!-- ADD RACE VIEW -->
        <div id="view-add-race" class="view-section">
            <div class="page-header">
                <h2>New Race</h2>
                <p>Record a new Sus Cup event</p>
            </div>
            <div class="card">
                <form id="form-add-race">
                    <div class="grid-4">
                        <div class="form-group"><label>Cup Number</label><input type="text" id="ar-cup" class="form-control" required placeholder="e.g. 2"></div>
                        <div class="form-group"><label>Race Name</label><input type="text" id="ar-name" class="form-control" required placeholder="e.g. Arima Kinen"></div>
                        <div class="form-group"><label>Date</label><input type="date" id="ar-date" class="form-control" required></div>
                        <div class="form-group"><label>Distance (m)</label><input type="number" id="ar-dist" class="form-control" required placeholder="2400"></div>
                    </div>
                    
                    <h3 style="margin: 30px 0 20px;">Participants</h3>
                    <div id="runners-container"></div>
                    <button type="button" class="btn btn-outline" style="margin-bottom: 30px;" onclick="App.addRunnerRow()"><i class="fa-solid fa-plus"></i> Add Runner</button>

                    <div style="text-align: right; border-top: 2px solid #f2ebe1; padding-top: 30px;">
                        <button type="submit" class="btn btn-primary">Save Race Results</button>
                    </div>
                </form>
            </div>
        </div>

    </main>

    <script>
        const INITIAL_DATA = {
            winners: [
                {"cup": "Sus Cup 6", "trainer": "Cyclobly", "uma": "Gold Ship", "version": "Original / Default", "url": "https://gametora.com/umamusume/characters/gold-ship", "race": "UNIQUE EPITHETS / STEAMY SOLIDARITY", "date": "2025-09-03", "result": "2:29.0"},
